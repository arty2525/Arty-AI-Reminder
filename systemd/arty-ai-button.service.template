[Unit]
Description=Arty AI Reminder Push Button Service
After=local-fs.target sound.target arty-ai-reminder.service

[Service]
Type=simple
User=__USER__
Group=__GROUP__
SupplementaryGroups=audio gpio
WorkingDirectory=/opt/arty-ai-reminder
Environment=GPIOZERO_PIN_FACTORY=lgpio
ExecStart=/usr/bin/python3 /opt/arty-ai-reminder/button_daemon.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
