[Unit]
Description=Arty AI Reminder Daemon
After=local-fs.target sound.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
SupplementaryGroups=audio
WorkingDirectory=/opt/arty-ai-reminder
ExecStart=/usr/bin/python3 /opt/arty-ai-reminder/reminder_daemon.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
